 "sentences": [
  {
   "id": "s01",
   "section": "hook",
   "text": "Тринадцать лет ожидания.",
   "start": 0.55,
   "end": 2.665
  },
  {
   "id": "s02",
   "section": "hook",
   "text": "Миллионы игроков по всему миру.",
   "start": 2.885,
   "end": 5.3
  },
  {
   "id": "s03",
   "section": "hook",
   "text": "И теперь GTA 6 готовится стать одним из самых громких событий в истории видеоигр.",
   "start": 5.52,
   "end": 11.047
  },
  {
   "id": "s04",
   "section": "characters",
   "text": "В центре истории — Джейсон и Люсия.",
   "start": 11.93,
   "end": 15.02
  },
  {
   "id": "s05",
   "section": "characters",
   "text": "Двое людей, оказавшихся в мире, где доверие может стоить дороже денег, а каждый неправильный шаг меняет всё.",
   "start": 15.24,
   "end": 22.092
  },
  {
   "id": "s06",
   "section": "vicecity",
   "text": "Добро пожаловать в Вайс-Сити.",
   "start": 22.974,
   "end": 25.252
  },
  {
   "id": "s07",
   "section": "vicecity",
   "text": "Неоновые улицы, бесконечные дороги, пляжи, ночная жизнь и атмосфера, в которой каждый уголок словно рассказывает собственную историю.",
   "start": 25.472,
   "end": 34.224
  },
  {
   "id": "s08",
   "section": "world",
   "text": "Rockstar делает ставку не просто на красивую картинку.",
   "start": 35.106,
   "end": 38.533
  },
  {
   "id": "s09",
   "section": "world",
   "text": "Важны детали, персонажи, окружающий мир и ощущение живого города.",
   "start": 38.753,
   "end": 43.868
  },
  {
   "id": "s10",
   "section": "world",
   "text": "Именно такие мелочи заставляют игроков возвращаться снова и снова.",
   "start": 44.088,
   "end": 48.603
  },
  {
   "id": "s11",
   "section": "expectations",
   "text": "Ожидания огромны.",
   "start": 49.485,
   "end": 51.275
  },
  {
   "id": "s12",
   "section": "expectations",
   "text": "Поклонники надеются увидеть новый уровень открытого мира, свободы и кинематографичного повествования.",
   "start": 51.495,
   "end": 58.085
  },
  {
   "id": "s13",
   "section": "expectations",
   "text": "Но действительно ли игра сможет оправдать весь этот ажиотаж?",
   "start": 58.305,
   "end": 62.233
  },
  {
   "id": "s14",
   "section": "final",
   "text": "Одно можно сказать точно: GTA 6 уже стала одним из самых обсуждаемых игровых проектов современности.",
   "start": 63.115,
   "end": 69.793
  },
  {
   "id": "s15",
   "section": "final",
   "text": "И главный вопрос теперь не в том, насколько громкой будет премьера.",
   "start": 70.013,
   "end": 74.252
  },
  {
   "id": "s16",
   "section": "final",
   "text": "А в том, сможет ли Rockstar превзойти собственную легенду.",
   "start": 74.472,
   "end": 78.4
  }
 ],
