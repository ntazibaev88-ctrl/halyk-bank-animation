{
 "l01": {
  "duration": 1.83,
  "speech": 1.409,
  "parts": [
   [
    0.0,
    1.289
   ]
  ],
  "text": [
   "В ту ночь город умер."
  ]
 },
 "l02": {
  "duration": 2.747,
  "speech": 2.326,
  "parts": [
   [
    0.0,
    2.206
   ]
  ],
  "text": [
   "По всем каналам — экстренный выпуск."
  ]
 },
 "l03": {
  "duration": 1.737,
  "speech": 1.316,
  "parts": [
   [
    0.0,
    1.196
   ]
  ],
  "text": [
   "Неизвестный вирус."
  ]
 },
 "l04": {
  "duration": 2.55,
  "speech": 2.129,
  "parts": [
   [
    0.0,
    2.009
   ]
  ],
  "text": [
   "Заражённые нападают на людей."
  ]
 },
 "l05": {
  "duration": 2.132,
  "speech": 1.711,
  "parts": [
   [
    0.0,
    1.591
   ]
  ],
  "text": [
   "Я проснулся от тишины."
  ]
 },
 "l06": {
  "duration": 1.516,
  "speech": 1.095,
  "parts": [
   [
    0.0,
    0.975
   ]
  ],
  "text": [
   "Подошёл к окну"
  ]
 },
 "l07": {
  "duration": 2.317,
  "speech": 1.896,
  "parts": [
   [
    0.0,
    1.776
   ]
  ],
  "text": [
   "и понял: города больше нет."
  ]
 },
 "l08": {
  "duration": 2.556,
  "speech": 2.135,
  "parts": [
   [
    0.0,
    1.3
   ],
   [
    1.55,
    2.015
   ]
  ],
  "text": [
   "Только дым... сирены...",
   "И они."
  ]
 },
 "l09": {
  "duration": 2.608,
  "speech": 2.187,
  "parts": [
   [
    0.0,
    2.067
   ]
  ],
  "text": [
   "А потом в дверь постучали."
  ]
 },
 "l10": {
  "duration": 1.783,
  "speech": 1.362,
  "parts": [
   [
    0.0,
    1.242
   ]
  ],
  "text": [
   "Сначала тихо."
  ]
 },
 "l11": {
  "duration": 2.7,
  "speech": 2.279,
  "parts": [
   [
    0.0,
    2.159
   ]
  ],
  "text": [
   "Потом — так, будто её хотели выбить."
  ]
 },
 "l12": {
  "duration": 2.062,
  "speech": 1.641,
  "parts": [
   [
    0.0,
    1.521
   ]
  ],
  "text": [
   "Я закрыл дверь на засов."
  ]
 },
 "l13": {
  "duration": 1.528,
  "speech": 1.107,
  "parts": [
   [
    0.0,
    0.987
   ]
  ],
  "text": [
   "Я схватил нож."
  ]
 },
 "l14": {
  "duration": 1.783,
  "speech": 1.362,
  "parts": [
   [
    0.0,
    1.242
   ]
  ],
  "text": [
   "Выключил свет."
  ]
 },
 "l15": {
  "duration": 3.213,
  "speech": 2.792,
  "parts": [
   [
    0.0,
    1.753
   ],
   [
    2.103,
    2.672
   ]
  ],
  "text": [
   "Спрятался в темноте.",
   "И ждал."
  ]
 },
 "l16": {
  "duration": 1.865,
  "speech": 1.444,
  "parts": [
   [
    0.0,
    1.324
   ]
  ],
  "text": [
   "Стук прекратился."
  ]
 },
 "l17": {
  "duration": 2.027,
  "speech": 1.606,
  "parts": [
   [
    0.0,
    1.486
   ]
  ],
  "text": [
   "И стало только страшнее."
  ]
 },
 "l18": {
  "duration": 1.865,
  "speech": 1.444,
  "parts": [
   [
    0.0,
    1.324
   ]
  ],
  "text": [
   "Телефон завибрировал."
  ]
 },
 "l19": {
  "duration": 1.598,
  "speech": 1.177,
  "parts": [
   [
    0.0,
    1.057
   ]
  ],
  "text": [
   "Неизвестный номер."
  ]
 },
 "l20": {
  "duration": 2.512,
  "speech": 1.594,
  "parts": [
   [
    0.0,
    1.474
   ]
  ],
  "text": [
   "Не открывай дверь."
  ]
 },
 "l21": {
  "duration": 2.641,
  "speech": 1.711,
  "parts": [
   [
    0.0,
    1.591
   ]
  ],
  "text": [
   "Я уже внутри."
  ]
 },
 "l22": {
  "duration": 2.271,
  "speech": 1.85,
  "parts": [
   [
    0.0,
    1.73
   ]
  ],
  "text": [
   "Я медленно обернулся."
  ]
 }
}