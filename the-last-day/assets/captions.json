[
 {
  "text": "В ту ночь",
  "start": 3.25,
  "end": 3.884,
  "show": 3.21,
  "hide": 3.864
 },
 {
  "text": "город *умер.*",
  "start": 3.884,
  "end": 4.659,
  "show": 3.844,
  "hide": 5.259
 },
 {
  "text": "По всем каналам —",
  "start": 5.5,
  "end": 6.63,
  "show": 5.46,
  "hide": 6.61
 },
 {
  "text": "экстренный выпуск.",
  "start": 6.63,
  "end": 7.826,
  "show": 6.59,
  "hide": 8.13
 },
 {
  "text": "Неизвестный *вирус.*",
  "start": 8.15,
  "end": 9.466,
  "show": 8.11,
  "hide": 9.68
 },
 {
  "text": "*Заражённые*",
  "start": 9.7,
  "end": 10.46,
  "show": 9.66,
  "hide": 10.44
 },
 {
  "text": "*нападают* на людей.",
  "start": 10.46,
  "end": 11.829,
  "show": 10.42,
  "hide": 12.429
 },
 {
  "text": "Я проснулся",
  "start": 12.7,
  "end": 13.596,
  "show": 12.66,
  "hide": 13.576
 },
 {
  "text": "от тишины.",
  "start": 13.596,
  "end": 14.411,
  "show": 13.556,
  "hide": 14.98
 },
 {
  "text": "Подошёл к окну...",
  "start": 15.0,
  "end": 16.095,
  "show": 14.96,
  "hide": 16.28
 },
 {
  "text": "и понял:",
  "start": 16.3,
  "end": 16.883,
  "show": 16.26,
  "hide": 16.863
 },
 {
  "text": "города больше *нет.*",
  "start": 16.883,
  "end": 18.196,
  "show": 16.843,
  "hide": 18.796
 },
 {
  "text": "Только дым... сирены...",
  "start": 19.0,
  "end": 20.3,
  "show": 18.96,
  "hide": 20.53
 },
 {
  "text": "И *они.*",
  "start": 20.55,
  "end": 21.015,
  "show": 20.51,
  "hide": 21.615
 },
 {
  "text": "А потом",
  "start": 23.4,
  "end": 24.012,
  "show": 23.36,
  "hide": 23.992
 },
 {
  "text": "в дверь *постучали.*",
  "start": 24.012,
  "end": 25.587,
  "show": 23.972,
  "hide": 25.68
 },
 {
  "text": "Сначала тихо.",
  "start": 25.7,
  "end": 27.062,
  "show": 25.66,
  "hide": 27.28
 },
 {
  "text": "Потом — так,",
  "start": 27.3,
  "end": 28.081,
  "show": 27.26,
  "hide": 28.061
 },
 {
  "text": "будто её хотели *выбить.*",
  "start": 28.081,
  "end": 29.579,
  "show": 28.041,
  "hide": 29.98
 },
 {
  "text": "Я закрыл дверь",
  "start": 30.0,
  "end": 30.999,
  "show": 29.96,
  "hide": 30.979
 },
 {
  "text": "на засов.",
  "start": 30.999,
  "end": 31.641,
  "show": 30.959,
  "hide": 32.241
 },
 {
  "text": "Я схватил *нож.*",
  "start": 32.9,
  "end": 34.007,
  "show": 32.86,
  "hide": 34.23
 },
 {
  "text": "Выключил свет.",
  "start": 34.25,
  "end": 35.612,
  "show": 34.21,
  "hide": 36.18
 },
 {
  "text": "Спрятался в *темноте.*",
  "start": 36.2,
  "end": 37.953,
  "show": 36.16,
  "hide": 38.283
 },
 {
  "text": "И ждал.",
  "start": 38.303,
  "end": 38.872,
  "show": 38.263,
  "hide": 39.472
 },
 {
  "text": "Стук прекратился.",
  "start": 41.0,
  "end": 42.444,
  "show": 40.96,
  "hide": 42.98
 },
 {
  "text": "И стало только",
  "start": 43.0,
  "end": 43.978,
  "show": 42.96,
  "hide": 43.958
 },
 {
  "text": "*страшнее.*",
  "start": 43.978,
  "end": 44.606,
  "show": 43.938,
  "hide": 45.206
 },
 {
  "text": "Телефон завибрировал.",
  "start": 45.9,
  "end": 47.344,
  "show": 45.86,
  "hide": 47.944
 },
 {
  "text": "*Неизвестный* номер.",
  "start": 48.0,
  "end": 49.177,
  "show": 47.96,
  "hide": 49.777
 },
 {
  "text": "«Не открывай *дверь.*»",
  "start": 50.05,
  "end": 51.644,
  "show": 50.01,
  "hide": 52.244
 },
 {
  "text": "«Я уже *внутри.*»",
  "start": 52.35,
  "end": 54.061,
  "show": 52.31,
  "hide": 54.661
 },
 {
  "text": "Я медленно *обернулся...*",
  "start": 55.5,
  "end": 57.35,
  "show": 55.46,
  "hide": 57.95
 }
]