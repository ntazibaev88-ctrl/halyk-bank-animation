 "clauses": [
  {
   "scene": "s1",
   "text": "Ты уверен, что сам принимаешь решения?",
   "start": 0.1,
   "end": 2.248
  },
  {
   "scene": "s1",
   "text": "А что, если твой мозг уже всё решил за тебя?",
   "start": 2.468,
   "end": 4.929
  },
  {
   "scene": "s2",
   "text": "Каждый день ты принимаешь сотни решений.",
   "start": 5.63,
   "end": 8.161
  },
  {
   "scene": "s2",
   "text": "Но большинство из них происходят почти автоматически.",
   "start": 8.611,
   "end": 11.746
  },
  {
   "scene": "s2",
   "text": "Твой мозг постоянно ищет короткий путь,",
   "start": 12.246,
   "end": 14.626
  },
  {
   "scene": "s2",
   "text": "экономит энергию",
   "start": 14.806,
   "end": 16.152
  },
  {
   "scene": "s2",
   "text": "и использует привычные шаблоны.",
   "start": 16.272,
   "end": 18.629
  },
  {
   "scene": "s3",
   "text": "Замечал, как неловкий момент пятилетней давности",
   "start": 20.53,
   "end": 23.467
  },
  {
   "scene": "s3",
   "text": "может всплыть в голове прямо перед сном?",
   "start": 23.517,
   "end": 25.967
  },
  {
   "scene": "s3",
   "text": "Мозг способен снова и снова возвращать тебя к неприятным воспоминаниям.",
   "start": 26.967,
   "end": 31.599
  },
  {
   "scene": "s4",
   "text": "Дело в том, что мозг не просто записывает реальность.",
   "start": 34.35,
   "end": 38.704
  },
  {
   "scene": "s4",
   "text": "Он отбирает информацию,",
   "start": 39.204,
   "end": 41.119
  },
  {
   "scene": "s4",
   "text": "интерпретирует её",
   "start": 41.269,
   "end": 42.883
  },
  {
   "scene": "s4",
   "text": "и заполняет пробелы.",
   "start": 42.983,
   "end": 44.701
  },
  {
   "scene": "s4",
   "text": "Поэтому твоя память —",
   "start": 45.401,
   "end": 47.259
  },
  {
   "scene": "s4",
   "text": "не идеальная видеозапись прошлого.",
   "start": 47.559,
   "end": 49.742
  },
  {
   "scene": "s5",
   "text": "Два человека могут пережить одно и то же событие,",
   "start": 51.79,
   "end": 54.53
  },
  {
   "scene": "s5",
   "text": "но запомнить его совершенно по-разному.",
   "start": 54.73,
   "end": 57.656
  },
  {
   "scene": "s5",
   "text": "Потому что на восприятие влияют эмоции,",
   "start": 58.456,
   "end": 61.265
  },
  {
   "scene": "s5",
   "text": "ожидания",
   "start": 61.515,
   "end": 62.235
  },
  {
   "scene": "s5",
   "text": "и предыдущий опыт.",
   "start": 62.455,
   "end": 64.115
  },
  {
   "scene": "s6",
   "text": "Так что в следующий раз, когда твой мозг скажет:",
   "start": 66.42,
   "end": 69.612
  },
  {
   "scene": "s6",
   "text": "«Я точно всё помню»,",
   "start": 70.162,
   "end": 71.625
  },
  {
   "scene": "s6",
   "text": "не спеши ему верить.",
   "start": 72.075,
   "end": 73.909
  },
  {
   "scene": "s6",
   "text": "Иногда самый хитрый обманщик —",
   "start": 74.859,
   "end": 77.982
  },
  {
   "scene": "s6",
   "text": "это тот, кто живёт у тебя в голове.",
   "start": 78.432,
   "end": 81.393
  },
  {
   "scene": "s6",
   "text": "А ты замечал за собой такое?",
   "start": 82.493,
   "end": 84.443
  }
 ],
