[
 {
  "start": 0.941,
  "end": 1.879,
  "text": "Тәуелсіздік...",
  "scene": 1
 },
 {
  "start": 2.529,
  "end": 4.178,
  "text": "Бұл — жай ғана сөз емес.",
  "scene": 1
 },
 {
  "start": 4.403,
  "end": 8.153,
  "text": "Бұл — тұтас бір халықтың\nғасырлар бойы аңсаған арманы.",
  "scene": 1
 },
 {
  "start": 8.321,
  "end": 11.063,
  "text": "Бұл — өз тағдырын өзі\nшешуге мүмкіндік алған",
  "scene": 1
 },
 {
  "start": 11.083,
  "end": 12.771,
  "text": "елдің жаңа тарихы.",
  "scene": 1
 },
 {
  "start": 13.582,
  "end": 16.407,
  "text": "1986 жылдың желтоқсаны.",
  "scene": 2
 },
 {
  "start": 16.576,
  "end": 19.231,
  "text": "Алматы алаңына шыққан\nжастар ел тағдырына бейжай",
  "scene": 2
 },
 {
  "start": 19.251,
  "end": 20.901,
  "text": "қарамайтынын көрсетті.",
  "scene": 2
 },
 {
  "start": 21.123,
  "end": 24.353,
  "text": "Желтоқсан оқиғасы —\nхалқымыздың тарихындағы ауыр",
  "scene": 2
 },
 {
  "start": 24.373,
  "end": 26.073,
  "text": "әрі маңызды кезең.",
  "scene": 2
 },
 {
  "start": 26.229,
  "end": 28.709,
  "text": "Оның құрбандары мен\nқаһармандары ел жадында",
  "scene": 2
 },
 {
  "start": 28.729,
  "end": 30.129,
  "text": "мәңгі сақталады.",
  "scene": 2
 },
 {
  "start": 30.865,
  "end": 34.332,
  "text": "1991 жылдың 16 желтоқсаны.",
  "scene": 3
 },
 {
  "start": 34.352,
  "end": 36.182,
  "text": "Қазақстан Республикасының\nмемлекеттік",
  "scene": 3
 },
 {
  "start": 36.202,
  "end": 38.027,
  "text": "тәуелсіздігі жарияланды.",
  "scene": 3
 },
 {
  "start": 38.181,
  "end": 40.598,
  "text": "Бұл күн халқымыздың\nтарихындағы жаңа дәуірдің",
  "scene": 3
 },
 {
  "start": 40.618,
  "end": 41.818,
  "text": "бастауы болды.",
  "scene": 3
 },
 {
  "start": 41.975,
  "end": 44.068,
  "text": "Қазақстан әлем картасында\nдербес мемлекет",
  "scene": 3
 },
 {
  "start": 44.088,
  "end": 46.188,
  "text": "ретінде өз жолын бастады.",
  "scene": 3
 },
 {
  "start": 46.96,
  "end": 49.32,
  "text": "Алдымызда үлкен\nміндеттер тұрды.",
  "scene": 4
 },
 {
  "start": 49.34,
  "end": 51.07,
  "text": "Өз мемлекеттілігімізді\nнығайту,",
  "scene": 4
 },
 {
  "start": 51.09,
  "end": 54.033,
  "text": "ұлттық валютамызды енгізу,\nхалықаралық аренада",
  "scene": 4
 },
 {
  "start": 54.053,
  "end": 56.69,
  "text": "өз орнымызды\nқалыптастыру қажет болды.",
  "scene": 4
 },
 {
  "start": 56.855,
  "end": 59.73,
  "text": "Қазақстан жаңа белестерге\nбатыл қадам басты.",
  "scene": 4
 },
 {
  "start": 60.606,
  "end": 62.731,
  "text": "Жылдар өте еліміз өзгерді.",
  "scene": 5
 },
 {
  "start": 62.909,
  "end": 65.876,
  "text": "Елордамыз бой көтеріп,\nжаңа қалалар мен заманауи",
  "scene": 5
 },
 {
  "start": 65.896,
  "end": 67.684,
  "text": "ғимараттар пайда болды.",
  "scene": 5
 },
 {
  "start": 67.704,
  "end": 70.384,
  "text": "Астана тәуелсіз Қазақстанның\nдамуы мен болашаққа",
  "scene": 5
 },
 {
  "start": 70.404,
  "end": 72.754,
  "text": "деген сенімінің\nсимволына айналды.",
  "scene": 5
 },
 {
  "start": 73.584,
  "end": 76.474,
  "text": "Елдің ең үлкен\nбайлығы — оның халқы.",
  "scene": 6
 },
 {
  "start": 76.494,
  "end": 78.749,
  "text": "Осы жылдар ішінде\nмиллиондаған адам өз",
  "scene": 6
 },
 {
  "start": 78.769,
  "end": 80.799,
  "text": "еңбегімен, білімімен\nжәне бірлігімен",
  "scene": 6
 },
 {
  "start": 80.819,
  "end": 83.469,
  "text": "Қазақстанның\nдамуына үлес қосты.",
  "scene": 6
 },
 {
  "start": 83.619,
  "end": 86.274,
  "text": "Біздің күшіміз — татулықта,\nбірлікте және ортақ",
  "scene": 6
 },
 {
  "start": 86.294,
  "end": 87.369,
  "text": "мақсатта.",
  "scene": 6
 },
 {
  "start": 88.205,
  "end": 90.593,
  "text": "Бүгінгі Қазақстан —\nмүмкіндіктер елі.",
  "scene": 7
 },
 {
  "start": 90.762,
  "end": 93.267,
  "text": "Өндіріс дамып, білім\nмен технологияға жол",
  "scene": 7
 },
 {
  "start": 93.287,
  "end": 96.242,
  "text": "ашылып, спорт пен мәдениетте\nжаңа жетістіктерге",
  "scene": 7
 },
 {
  "start": 96.262,
  "end": 97.782,
  "text": "қол жеткізілуде.",
  "scene": 7
 },
 {
  "start": 97.802,
  "end": 101.152,
  "text": "Әлі де атқарар ісіміз,\nбағындырар биігіміз көп.",
  "scene": 7
 },
 {
  "start": 101.952,
  "end": 105.182,
  "text": "Тәуелсіздіктің ең үлкен\nаманаты — келер ұрпақ.",
  "scene": 8
 },
 {
  "start": 105.202,
  "end": 108.053,
  "text": "Бүгінгі жастар — ертеңгі\nҚазақстанның иесі.",
  "scene": 8
 },
 {
  "start": 108.208,
  "end": 110.85,
  "text": "Олардың білімі, арманы\nмен еңбегі еліміздің",
  "scene": 8
 },
 {
  "start": 110.87,
  "end": 112.721,
  "text": "болашағын қалыптастырады.",
  "scene": 8
 },
 {
  "start": 113.493,
  "end": 115.59,
  "text": "Тәуелсіздігіміз\nмәңгі болсын!",
  "scene": 9
 },
 {
  "start": 115.61,
  "end": 117.25,
  "text": "Қазақстан жасай берсін!",
  "scene": 9
 }
]