[
 {
  "start": 3.53,
  "end": 4.62,
  "text": "Ты просыпаешься —"
 },
 {
  "start": 4.62,
  "end": 7,
  "text": "и твои ноги отрываются от пола."
 },
 {
  "start": 7.18,
  "end": 10.12,
  "text": "Ничто больше не прижимает тебя к полу."
 },
 {
  "start": 10.18,
  "end": 12.85,
  "text": "Но ты не улетаешь вверх, как ракета."
 },
 {
  "start": 12.91,
  "end": 15.73,
  "text": "Всё вокруг продолжает двигаться по инерции,"
 },
 {
  "start": 15.82,
  "end": 18.24,
  "text": "а вращающаяся Земля медленно"
 },
 {
  "start": 18.24,
  "end": 20,
  "text": "уходит из-под ног."
 },
 {
  "start": 20.16,
  "end": 21.5,
  "text": "На улицах — хаос."
 },
 {
  "start": 21.5,
  "end": 23.74,
  "text": "Без веса у колёс нет сцепления с дорогой,"
 },
 {
  "start": 23.74,
  "end": 25.61,
  "text": "и машины не могут затормозить."
 },
 {
  "start": 25.61,
  "end": 27.65,
  "text": "Любой толчок отправляет людей и"
 },
 {
  "start": 27.65,
  "end": 29.71,
  "text": "незакреплённые вещи в полёт."
 },
 {
  "start": 29.71,
  "end": 31.53,
  "text": "А самолёты теряют управление:"
 },
 {
  "start": 31.53,
  "end": 34,
  "text": "воздуха вокруг становится всё меньше."
 },
 {
  "start": 34.18,
  "end": 37.07,
  "text": "Атмосферу больше ничто не держит."
 },
 {
  "start": 37.29,
  "end": 38.49,
  "text": "Собственное давление"
 },
 {
  "start": 38.49,
  "end": 40.68,
  "text": "выталкивает воздух в космос."
 },
 {
  "start": 40.88,
  "end": 42.06,
  "text": "А океаны при падающем"
 },
 {
  "start": 42.06,
  "end": 43.99,
  "text": "давлении начинают кипеть"
 },
 {
  "start": 44.21,
  "end": 46.08,
  "text": "и медленно расползаются от планеты"
 },
 {
  "start": 46.08,
  "end": 48,
  "text": "облаками пара и капель."
 },
 {
  "start": 48.16,
  "end": 50.07,
  "text": "Но главное — сама Земля."
 },
 {
  "start": 50.07,
  "end": 52.44,
  "text": "Её недра сжаты собственной гравитацией"
 },
 {
  "start": 52.44,
  "end": 54.15,
  "text": "под колоссальным давлением."
 },
 {
  "start": 54.15,
  "end": 56.21,
  "text": "Без неё сжатое вещество"
 },
 {
  "start": 56.21,
  "end": 57.93,
  "text": "начинает расширяться."
 },
 {
  "start": 57.93,
  "end": 59.3,
  "text": "Это не мгновенный взрыв:"
 },
 {
  "start": 59.3,
  "end": 60.24,
  "text": "кора трескается,"
 },
 {
  "start": 60.24,
  "end": 63,
  "text": "и планета постепенно распадается на части."
 },
 {
  "start": 63.14,
  "end": 66.12,
  "text": "А человек оказывается в открытом космосе."
 },
 {
  "start": 66.34,
  "end": 68.51,
  "text": "Воздуха для дыхания больше нет."
 },
 {
  "start": 68.73,
  "end": 70.36,
  "text": "Без скафандра сознание уходит"
 },
 {
  "start": 70.36,
  "end": 72.66,
  "text": "примерно через пятнадцать секунд."
 },
 {
  "start": 72.83,
  "end": 74.42,
  "text": "Остаются только тишина,"
 },
 {
  "start": 74.42,
  "end": 77,
  "text": "вакуум и жёсткое излучение Солнца."
 },
 {
  "start": 77.17,
  "end": 79.76,
  "text": "Но гравитация Солнца никуда не исчезла:"
 },
 {
  "start": 79.76,
  "end": 81.14,
  "text": "обломки Земли продолжат"
 },
 {
  "start": 81.14,
  "end": 82.91,
  "text": "кружить по её орбите."
 },
 {
  "start": 82.91,
  "end": 85.05,
  "text": "Только нашего дома больше нет."
 }
]