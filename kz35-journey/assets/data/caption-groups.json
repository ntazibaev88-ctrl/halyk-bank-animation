[
 {
  "line": "l01",
  "show": "*Қазақстан...*",
  "start": 1.529,
  "end": 2.034333,
  "in": 1.409,
  "out": 2.634
 },
 {
  "line": "l02",
  "show": "Ұлы даланың төсінде орналасқан,",
  "start": 2.8007500000000003,
  "end": 4.497207,
  "in": 2.681,
  "out": 4.383
 },
 {
  "line": "l02",
  "show": "тарихы *терең*, табиғаты *бай*,",
  "start": 4.522708,
  "end": 6.155333000000001,
  "in": 4.403,
  "out": 6.079
 },
 {
  "line": "l02",
  "show": "болашағы *зор* мемлекет.",
  "start": 6.219125,
  "end": 7.647708000000001,
  "in": 6.099,
  "out": 8.199
 },
 {
  "line": "l03",
  "show": "*1991* жылы",
  "start": 8.339291,
  "end": 9.908166,
  "in": 8.219,
  "out": 9.768
 },
 {
  "line": "l03",
  "show": "еліміз *тәуелсіздігін* алып,",
  "start": 9.908166,
  "end": 11.260207999999999,
  "in": 9.788,
  "out": 11.158
 },
 {
  "line": "l03",
  "show": "жаңа *даму жолына* қадам басты.",
  "start": 11.298458,
  "end": 13.530624,
  "in": 11.178,
  "out": 14.131
 },
 {
  "line": "l04",
  "show": "Бұл — Қазақстан тарихындағы",
  "start": 14.413791000000002,
  "end": 15.995416,
  "in": 14.294,
  "out": 15.868
 },
 {
  "line": "l04",
  "show": "*жаңа дәуірдің* басталуы еді.",
  "start": 16.008166,
  "end": 17.691833000000003,
  "in": 15.888,
  "out": 18.174
 },
 {
  "line": "l05",
  "show": "*35 жыл* ішінде еліміз",
  "start": 18.313791,
  "end": 19.882624,
  "in": 18.194,
  "out": 19.755
 },
 {
  "line": "l05",
  "show": "үлкен *өзгерістерден* өтті.",
  "start": 19.895416,
  "end": 21.477041,
  "in": 19.775,
  "out": 21.974
 },
 {
  "line": "l06",
  "show": "Мемлекеттік *шекарамыз* бекітіліп,",
  "start": 22.113791,
  "end": 23.708166,
  "in": 21.994,
  "out": 23.772
 },
 {
  "line": "l06",
  "show": "ұлттық *валютамыз* айналымға енді.",
  "start": 23.91225,
  "end": 25.914791,
  "in": 23.792,
  "out": 26.361
 },
 {
  "line": "l07",
  "show": "Қазақстан *әлемге танылып,*",
  "start": 26.50075,
  "end": 27.814541,
  "in": 26.381,
  "out": 27.917
 },
 {
  "line": "l07",
  "show": "халықаралық қауымдастықтың",
  "start": 28.056874999999998,
  "end": 29.459958,
  "in": 27.937,
  "out": 29.345
 },
 {
  "line": "l07",
  "show": "*толыққанды мүшесіне* айналды.",
  "start": 29.485457999999998,
  "end": 31.079873999999997,
  "in": 29.365,
  "out": 31.68
 },
 {
  "line": "l08",
  "show": "Елордамыз *Астана* бой көтеріп,",
  "start": 32.126541,
  "end": 33.784707,
  "in": 32.007,
  "out": 33.721
 },
 {
  "line": "l08",
  "show": "заманауи сәулетімен",
  "start": 33.861208,
  "end": 35.098458,
  "in": 33.741,
  "out": 34.958
 },
 {
  "line": "l08",
  "show": "еліміздің *жаңа келбетін* қалыптастырды.",
  "start": 35.098458,
  "end": 37.266833,
  "in": 34.978,
  "out": 37.867
 },
 {
  "line": "l09",
  "show": "Қазақстан — *табиғи байлығы* мол мемлекет.",
  "start": 44.1005,
  "end": 46.268874,
  "in": 43.98,
  "out": 46.774
 },
 {
  "line": "l10",
  "show": "*Мұнай мен газ, көмір, мыс, уран*",
  "start": 46.913790999999996,
  "end": 49.452040999999994,
  "in": 46.794,
  "out": 49.312
 },
 {
  "line": "l10",
  "show": "және басқа да пайдалы қазбалар",
  "start": 49.452040999999994,
  "end": 51.161207999999995,
  "in": 49.332,
  "out": 51.047
 },
 {
  "line": "l10",
  "show": "еліміздің *өндірістік әлеуетін* қалыптастырып келеді.",
  "start": 51.186749999999996,
  "end": 53.737748999999994,
  "in": 51.067,
  "out": 54.287
 },
 {
  "line": "l11",
  "show": "*Металлургия, энергетика,* машина жасау",
  "start": 54.426541,
  "end": 57.041332,
  "in": 54.307,
  "out": 56.965
 },
 {
  "line": "l11",
  "show": "және *өнеркәсіп* салалары дамып,",
  "start": 57.105083,
  "end": 58.865291,
  "in": 56.985,
  "out": 58.802
 },
 {
  "line": "l11",
  "show": "мыңдаған адамға *еңбек етуге* мүмкіндік берді.",
  "start": 58.941832999999995,
  "end": 61.696915999999995,
  "in": 58.822,
  "out": 62.297
 },
 {
  "line": "l12",
  "show": "*Ауыл шаруашылығы* да",
  "start": 62.964791,
  "end": 63.895916,
  "in": 62.845,
  "out": 63.947
 },
 {
  "line": "l12",
  "show": "еліміздің маңызды салаларының бірі.",
  "start": 64.08725,
  "end": 65.898499,
  "in": 63.967,
  "out": 66.361
 },
 {
  "line": "l13",
  "show": "Кең байтақ даламызда *бидай* өсіп,",
  "start": 66.501,
  "end": 68.29950000000001,
  "in": 66.381,
  "out": 68.364
 },
 {
  "line": "l13",
  "show": "*мал шаруашылығы* мен азық-түлік өндірісі",
  "start": 68.503583,
  "end": 70.62091600000001,
  "in": 68.384,
  "out": 70.481
 },
 {
  "line": "l13",
  "show": "дамып келеді.",
  "start": 70.62091600000001,
  "end": 71.23316600000001,
  "in": 70.501,
  "out": 71.833
 },
 {
  "line": "l14",
  "show": "*Білім мен ғылымға* жол ашылып,",
  "start": 72.426541,
  "end": 73.944416,
  "in": 72.307,
  "out": 73.97
 },
 {
  "line": "l14",
  "show": "жаңа *оқу орындары,* технологиялар",
  "start": 74.110208,
  "end": 76.393374,
  "in": 73.99,
  "out": 76.253
 },
 {
  "line": "l14",
  "show": "мен *мүмкіндіктер* пайда болды.",
  "start": 76.39337499999999,
  "end": 77.834666,
  "in": 76.273,
  "out": 78.36
 },
 {
  "line": "l15",
  "show": "Қазақтың *мәдениеті, тілі,*",
  "start": 78.5005,
  "end": 79.941833,
  "in": 78.38,
  "out": 79.968
 },
 {
  "line": "l15",
  "show": "*дәстүрі* мен ұлттық *өнері*",
  "start": 80.10766600000001,
  "end": 81.523458,
  "in": 79.988,
  "out": 81.422
 },
 {
  "line": "l15",
  "show": "*ұрпақтан ұрпаққа* жалғасып келеді.",
  "start": 81.56175,
  "end": 83.500499,
  "in": 81.442,
  "out": 84.1
 },
 {
  "line": "l16",
  "show": "Бүгінде Қазақстан *цифрлық технологияларды* дамытып,",
  "start": 84.826541,
  "end": 87.65816600000001,
  "in": 84.707,
  "out": 87.646
 },
 {
  "line": "l16",
  "show": "*жасанды интеллект,* заманауи өндіріс",
  "start": 87.785708,
  "end": 90.272958,
  "in": 87.666,
  "out": 90.146
 },
 {
  "line": "l16",
  "show": "және *жаңартылатын энергия*",
  "start": 90.285708,
  "end": 91.892874,
  "in": 90.166,
  "out": 91.753
 },
 {
  "line": "l16",
  "show": "бағыттарына қадам басуда.",
  "start": 91.892875,
  "end": 93.423499,
  "in": 91.773,
  "out": 94.023
 },
 {
  "line": "l17",
  "show": "Бірақ еліміздің *ең үлкен байлығы* —",
  "start": 94.528125,
  "end": 96.416166,
  "in": 94.408,
  "out": 96.315
 },
 {
  "line": "l17",
  "show": "оның *адамдары.*",
  "start": 96.455208,
  "end": 97.39274900000001,
  "in": 96.335,
  "out": 97.975
 },
 {
  "line": "l18",
  "show": "*Еңбекқор халық,*",
  "start": 98.115125,
  "end": 99.143749,
  "in": 97.995,
  "out": 99.108
 },
 {
  "line": "l18",
  "show": "білімге ұмтылған *жастар*",
  "start": 99.247916,
  "end": 100.69325,
  "in": 99.128,
  "out": 100.71
 },
 {
  "line": "l18",
  "show": "және өз болашағына сенетін *ұрпақ.*",
  "start": 100.8495,
  "end": 102.971874,
  "in": 100.73,
  "out": 103.572
 },
 {
  "line": "l19",
  "show": "*35 жыл* — бұл тек өткен тарих емес.",
  "start": 103.715125,
  "end": 105.90262399999999,
  "in": 103.595,
  "out": 106.262
 },
 {
  "line": "l20",
  "show": "Бұл — үлкен *тәжірибе,*",
  "start": 106.40208299999999,
  "end": 107.678125,
  "in": 106.282,
  "out": 107.681
 },
 {
  "line": "l20",
  "show": "жеткен *жетістік*",
  "start": 107.821375,
  "end": 108.706791,
  "in": 107.701,
  "out": 108.593
 },
 {
  "line": "l20",
  "show": "және алдағы *мүмкіндіктер.*",
  "start": 108.732833,
  "end": 110.23020799999999,
  "in": 108.613,
  "out": 110.762
 },
 {
  "line": "l21",
  "show": "Қазақстанның *дамуы жалғасуда.*",
  "start": 110.90208299999999,
  "end": 112.63387399999999,
  "in": 110.782,
  "out": 113.062
 },
 {
  "line": "l22",
  "show": "Ал еліміздің *болашағы* —",
  "start": 113.20208299999999,
  "end": 114.439082,
  "in": 113.082,
  "out": 114.377
 },
 {
  "line": "l22",
  "show": "*өз қолымызда!*",
  "start": 114.517208,
  "end": 115.376582,
  "in": 114.397,
  "out": 115.962
 },
 {
  "line": "l23",
  "show": "*Қазақстан — біздің ортақ үйіміз!*",
  "start": 116.102083,
  "end": 117.677624,
  "in": 115.982,
  "out": 118.278
 }
]